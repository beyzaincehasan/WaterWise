# ==============================================================================
# WaterWise Backend Yapılandırma Şablonu (.env.example)
# Gerçek değerler için bu dosyayı kopyalayarak '.env' oluşturun.
# ==============================================================================

# Veritabanı Bağlantısı:
# Varsayılan: SQLite (backend dizini içinde su tüketim verilerini tutar)
DATABASE_URL=sqlite:///./waterwise.db
# PostgreSQL örneği:
# DATABASE_URL=postgresql+psycopg2://postgres:sifre@localhost:5432/waterwise

# CORS İzinleri (React frontend için virgülle ayrılmış adresler)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Proje Ayarları
PROJECT_NAME="WaterWise Su Tüketim Analizi ve Anomali Tespit API"
API_V1_STR=/api/v1
DEBUG=False

