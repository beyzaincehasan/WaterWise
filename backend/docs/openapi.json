  "components": {
    "schemas": {
      "AnomalyDetectRequest": {
        "properties": {
          "apartment_id": {
            "type": "string",
            "title": "Apartment Id",
            "description": "Tahmin yapılacak daire (ör. APT_011)"
          },
          "target_timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Timestamp",
            "description": "Değerlendirilecek saat (ISO formatı UTC veya yerel saat). Verilmezse son kayıt saati alınır."
          },
          "history_days": {
            "type": "integer",
            "title": "History Days",
            "description": "Geriye dönük incelenecek gün sayısı (önerilen 28)",
            "default": 28
          },
          "save_log": {
            "type": "boolean",
            "title": "Save Log",
            "description": "Sonuç 'Anormal' veya 'Şüpheli' ise anomali log tablosuna kaydedilsin mi?",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "apartment_id"
        ],
        "title": "AnomalyDetectRequest"
      },
      "AnomalyHistoryInfo": {
        "properties": {
          "sufficient": {
            "type": "boolean",
            "title": "Sufficient",
            "description": "Geçmiş veri miktarı yeterli mi?"
          },
          "profile_fallback_used": {
            "type": "boolean",
            "title": "Profile Fallback Used",
            "description": "Eksik geçmiş nedeniyle eğitim profili yedek olarak kullanıldı mı?"
          },
          "apartment_profile_available": {
            "type": "boolean",
            "title": "Apartment Profile Available",
            "description": "Daireye özel profil var mı?"
          }
        },
        "type": "object",
        "required": [
          "sufficient",
          "profile_fallback_used",
          "apartment_profile_available"
        ],
        "title": "AnomalyHistoryInfo"
      },
      "AnomalyLogItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "apartment_id": {
            "type": "string",
            "title": "Apartment Id"
          },
          "timestamp_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp Utc"
          },
          "timestamp_local": {
            "type": "string",
            "title": "Timestamp Local"
          },
          "consumption_liters": {
            "type": "number",
            "title": "Consumption Liters"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "anomaly_score": {
            "type": "number",
            "title": "Anomaly Score",
            "description": "Isolation Forest anomali skoru (0, 1]. Yüksek skor = daha olağandışı. Olasılık değildir."
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "reasons": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Reasons"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "is_demo": {
            "type": "boolean",
            "title": "Is Demo"
          }
        },
        "type": "object",
        "required": [
          "id",
          "apartment_id",
          "timestamp_utc",
          "timestamp_local",
          "consumption_liters",
          "status",
          "anomaly_score",
          "message",
          "created_at",
          "is_demo"
        ],
        "title": "AnomalyLogItem"
      },
      "AnomalyPredictionResponse": {
        "properties": {
          "apartment_id": {
            "type": "string",
            "title": "Apartment Id",
            "description": "Değerlendirilen daire kimliği"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "Değerlendirilen saatin başlangıcı (UTC, ISO-8601 'Z')"
          },
          "timestamp_local": {
            "type": "string",
            "title": "Timestamp Local",
            "description": "Değerlendirilen anın yerel saati (Europe/Stockholm)"
          },
          "period_minutes": {
            "type": "integer",
            "title": "Period Minutes",
            "description": "Analiz periyodu (saatlik analiz için her zaman 60)",
            "default": 60
          },
          "consumption_liters": {
            "type": "number",
            "title": "Consumption Liters",
            "description": "O saatteki toplam tüketim (L)"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Anomali durumu ('Normal', 'Şüpheli', 'Anormal')"
          },
          "anomaly_score": {
            "type": "number",
            "title": "Anomaly Score",
            "description": "Isolation Forest anomali skoru (0, 1]. Yüksek skor = daha olağandışı kullanım. ÖNEMLİ: Bu değer kesinlikle bir olasılık (% kaçak olasılığı) DEĞİLDİR."
          },
          "thresholds": {
            "$ref": "#/components/schemas/ThresholdsSchema",
            "description": "Uygulanan eşik değerleri"
          },
          "normal_consumption_liters": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
